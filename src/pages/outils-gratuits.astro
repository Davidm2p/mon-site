---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const SITE_TITLE = 'Outils gratuits | M²P Coaching';
const SITE_DESCRIPTION = "Des guides courts et concrets, construits à partir du protocole M²P, pour avancer sur vos décisions et votre posture de dirigeant, manager ou professionnel RH.";
---
<!doctype html>
<html lang="fr">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>

      <!-- ════════════════════════════════
           HERO
           ════════════════════════════════ -->
      <section class="res-hero" style="background: #535861; color: #F4F1EA;">
        <div class="container">
          <p class="label">M²P Coaching</p>
          <h1>Outils gratuits</h1>
          <p class="res-hero-sous">Des outils courts et concrets, construits à partir du protocole M²P, pour avancer sur vos décisions et votre posture au quotidien.</p>
        </div>
      </section>

      <!-- ════════════════════════════════
           LISTE DES OUTILS
           ════════════════════════════════ -->
      <section class="res-liste">
        <div class="container">

          <div class="res-card">
            <p class="res-card-type">Guide PDF, 2 pages</p>
            <h2 class="res-card-titre">3 questions à se poser avant une décision importante</h2>
            <p class="res-card-desc">Un outil court, à garder sous la main, pour retrouver de la clarté avant d'agir, construit à partir du protocole utilisé dans les accompagnements M²P.</p>
            <a class="res-card-cta" href="/guide-decision">Recevoir le guide</a>
          </div>

          <div class="res-card">
            <p class="res-card-type">Guide PDF, 3 pages</p>
            <h2 class="res-card-titre">Le coût caché de l'immobilisme</h2>
            <p class="res-card-desc">Une matrice à remplir pour mesurer ce qu'une décision en suspens produit réellement, construite à partir des quatre questions cartésiennes utilisées en préparation mentale et en coaching.</p>
            <a class="res-card-cta" href="/guide-cout-immobilisme.pdf" target="_blank" rel="noopener">Télécharger le guide</a>
          </div>

        </div>
      </section>

      <!-- ════════════════════════════════
           À VENIR
           ════════════════════════════════ -->
      <section class="res-avenir">
        <div class="container">
          <p class="res-avenir-texte">De nouveaux outils rejoignent régulièrement cette page. Réservez un échange de 30 minutes pour évoquer directement votre situation.</p>
          <a class="res-avenir-lien" href="https://thecoachpilot.com/book/david-delord/echange-decouverte-30-min-m-p-coaching" target="_blank" rel="noopener">Réserver un échange de 30 minutes →</a>
        </div>
      </section>

    </main>
    <Footer />
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; }

  :root {
    --kaki:  #535861;
    --or:    #C99763;
    --or-p:  #b07d45;
    --creme: #F4F1EA;
    --sage:  #7F9B88;
    --texte: #3F4247;
    --blanc: #ffffff;
    --rayon: 4px;
  }

  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--or);
    font-weight: 600;
    margin-bottom: 0.6rem;
    display: block;
  }

  /* ── HERO ── */
  .res-hero {
    padding: 4rem 1.5rem 3.5rem;
  }
  .res-hero h1 {
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--creme);
    margin: 0 0 1rem;
    max-width: 640px;
  }
  .res-hero-sous {
    font-size: 1rem;
    color: #C8C4B8;
    line-height: 1.75;
    max-width: 600px;
  }

  /* ── LISTE ── */
  .res-liste {
    background: var(--blanc);
    padding: 4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .res-card {
    background: var(--creme);
    border-radius: var(--rayon);
    border-left: 4px solid var(--or);
    padding: 2rem 2rem 2.25rem;
    max-width: 560px;
  }
  .res-card-type {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sage);
    font-weight: 600;
    margin: 0 0 0.75rem;
  }
  .res-card-titre {
    font-size: 1.3rem;
    color: var(--kaki);
    margin: 0 0 0.85rem;
    line-height: 1.3;
  }
  .res-card-desc {
    font-size: 0.95rem;
    color: var(--texte);
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }
  .res-card-cta {
    display: inline-block;
    background: var(--or);
    color: var(--blanc);
    text-decoration: none;
    font-weight: 600;
    padding: 0.8rem 1.5rem;
    border-radius: 50px;
    font-size: 0.9rem;
  }
  .res-card-cta:hover { background: var(--or-p); }

  /* ── À VENIR ── */
  .res-avenir {
    background: var(--creme);
    text-align: center;
    padding: 3.5rem 1.5rem;
  }
  .res-avenir-texte {
    font-size: 0.95rem;
    color: var(--texte);
    line-height: 1.7;
    margin: 0 0 1rem;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }
  .res-avenir-lien {
    color: var(--sage);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }
  .res-avenir-lien:hover { text-decoration: underline; }

  @media (min-width: 768px) {
    .res-hero h1 { font-size: 2.3rem; }
  }
</style>

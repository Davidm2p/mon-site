        "Vous restez souple sur le délai, pour ne mettre personne sous pression.",
        "Face à des retards répétés, vous attendez le bon moment pour en parler.",
        "Vous présentez la charge en plus sans trop insister sur l'effort.",
        "Votre N+1 vous encourage à oser trancher.",
        "Le dimanche soir, vous repensez à une conversation délicate pas encore eue."
      ],
      "regle": "« Si je dis non, j'abîme la relation. »",
      "regleTxt": "Cette règle fait de vous un manager à l'écoute, apprécié de son équipe. Aujourd'hui, elle laisse les problèmes grossir et use la relation qu'elle veut protéger.",
      "cout": [
        "Les sujets difficiles s'accumulent et pèsent sur tout le service.",
        "Les personnes fiables portent la charge des autres.",
        "Votre parole perd du poids, faute de décisions tranchées."
      ],
      "aide": "Nous mettons au jour la règle qui vous pousse à adoucir. Vous préparez la conversation que vous repoussez, mot à mot, puis vous la menez. Séance après séance, vous gagnez en fermeté, vous tranchez plus vite et votre équipe sait où elle va.",
      "phrase": "Agir n'abîme pas la relation. C'est ne pas agir qui l'use."
    }
  ];
  var cur=0, sc=[0,0,0], ans=[-1,-1,-1,-1,-1,-1,-1], ordre=[];
  function melange(t) { for (var k = t.length - 1; k > 0; k--) { var j = Math.floor(Math.random() * (k + 1)); var x = t[k]; t[k] = t[j]; t[j] = x; } return t; }

  function el(id){ return document.getElementById(id); }
  function render() {
    var q = Q[cur];
    el('diag-num').textContent = 'Question '+(cur+1)+' sur '+Q.length;
    el('diag-question').textContent = q.q;
    el('diag-bar').style.width = (cur/Q.length*100)+'%';
    var box = el('diag-options');
    box.innerHTML = '';
    if (!ordre[cur]) { ordre[cur] = melange(q.opts.map(function(_, k) { return k; })); }
    ordre[cur].forEach(function(i, pos) {
      var o = q.opts[i];
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.k = i;
      btn.className = 'diag-opt' + (ans[cur]===i ? ' active' : '');
      var n = document.createElement('span'); n.className = 'opt-num'; n.textContent = pos+1;
      var t = document.createElement('span'); t.className = 'opt-txt'; t.textContent = o.t;
      btn.appendChild(n); btn.appendChild(t);
      btn.onclick = function() { pick(i); };
      box.appendChild(btn);
    });
    var next = el('diag-next');
    next.disabled = ans[cur] < 0;
    next.textContent = cur === Q.length-1 ? 'Voir le résultat' : 'Continuer';
    el('diag-back').style.display = cur > 0 ? 'inline-block' : 'none';
    el('diag-result').style.display = 'none';
    box.style.display = 'flex';
    el('diag-nav').style.display = 'flex';
    el('diag-question').style.display = 'block'; el('diag-consigne').style.display = 'block';
    el('diag-num').style.display = 'block';
    el('diag-bar').parentElement.parentElement.style.display = 'flex';
  }
  function pick(i) {
    ans[cur] = i;
    document.querySelectorAll('.diag-opt').forEach(function(b, idx) { b.classList.toggle('active', Number(b.dataset.k) === i); });
    el('diag-next').disabled = false;
  }
  window.diagNext = function() {
    if (ans[cur] < 0) return;
    Q[cur].opts[ans[cur]].s.forEach(function(v, i) { sc[i] += v; });
    if (cur < Q.length-1) { cur++; render(); } else { showResult(); }
  };
  window.diagBack = function() {
    if (cur === 0) return;
    Q[cur-1].opts[ans[cur-1]].s.forEach(function(v, i) { sc[i] -= v; });
    cur--; render();
  };
  window.diagRestart = function() { cur=0; sc=[0,0,0]; ans=[-1,-1,-1,-1,-1,-1,-1]; ordre=[]; render(); };
  function showResult() {
    el('diag-bar').style.width = '100%';
    var total = sc.reduce(function(x, y) { return x + y; }, 0) || 1;
    var max = Math.max.apply(null, sc);
    var box = el('diag-scores'); box.innerHTML = '';
    var titre = document.createElement('p'); titre.className = 'scores-titre'; titre.textContent = 'Vos 3 D';
    box.appendChild(titre);

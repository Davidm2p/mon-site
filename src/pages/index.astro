      var pct = Math.round(sc[i] / total * 100);
      var row = document.createElement('div'); row.className = 'score-row' + (sc[i] === max ? ' score-row--top' : '');
      var lab = document.createElement('span'); lab.className = 'score-lab'; lab.textContent = p.tag;
      var tr = document.createElement('span'); tr.className = 'score-track';
      var fill = document.createElement('span'); fill.className = 'score-fill'; fill.style.width = pct + '%';
      tr.appendChild(fill);
      var val = document.createElement('span'); val.className = 'score-val'; val.textContent = pct + ' %';
      row.appendChild(lab); row.appendChild(tr); row.appendChild(val); box.appendChild(row);
    });
    var cards = el('diag-cards'); cards.innerHTML = '';
    var mk = function(tag, cls, txt, parent) { var e = document.createElement(tag); e.className = cls; if (txt) e.textContent = txt; parent.appendChild(e); return e; };
    P.forEach(function(p, i) {
      if (sc[i] !== max) return;

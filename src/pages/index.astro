<script>
document.addEventListener('DOMContentLoaded', function() {
  var Q = [
    { q: "Où en êtes-vous aujourd'hui ?", opts: [
      { t: "Je viens d'être promu manager dans mon entreprise", s: [5,0,0,0] },
      { t: "Je viens de signer pour un poste de manager dans une nouvelle organisation", s: [0,5,0,0] },
      { t: "Je recrute ou je promeus un manager", s: [0,0,5,0] },
      { t: "J'ai pris mon poste de manager il y a quelques mois", s: [0,0,0,5] }
    ]},
    { q: "Qu'est-ce qui vous occupe le plus en ce moment ?", opts: [
      { t: "Trouver ma place face à d'anciens collègues", s: [3,0,0,0] },
      { t: "Comprendre une culture et des codes que je découvre", s: [0,3,0,1] },
      { t: "Donner toutes ses chances à la personne qui arrive", s: [0,0,3,0] },
      { t: "Retrouver de l'assise dans un poste plus exigeant que prévu", s: [0,0,0,3] }
    ]},
    { q: "Si vous pouviez changer une chose dès demain ?", opts: [
      { t: "Savoir ce que j'installe en premier", s: [2,2,0,1] },
      { t: "Asseoir ma légitimité avec justesse", s: [2,1,0,1] },
      { t: "Voir le recrutement se confirmer dans les premiers mois", s: [0,0,3,0] },
      { t: "Retrouver une posture qui me ressemble", s: [0,1,0,3] }
    ]}
  ];
  var P = [
    { tag: "Promotion interne", link: "/prise-de-poste", titre: "Vous connaissez la maison. Votre place, elle, est nouvelle.", desc: "Vos anciens collègues deviennent votre équipe. Les relations se recomposent, les attentes aussi. Le coaching vous donne un espace pour définir la posture que vous voulez tenir, et la manière de l'installer.", phrase: "Passer de collègue à manager, en restant vous-même." },
    { tag: "Recrutement externe", link: "/prise-de-poste", titre: "Vous avez signé. Votre place reste à construire.", desc: "Une équipe, une culture et des attentes à découvrir, dont une partie reste implicite. Ce moment se prépare. Nous travaillons vos intentions avant l'arrivée, puis votre lecture du terrain dans les premières semaines.", phrase: "Arriver préparé. Trouver sa place." },
    { tag: "RH et dirigeants", link: "/organisations", titre: "Un recrutement se décide en quelques semaines. Il se confirme sur le terrain.", desc: "Vous avez choisi. Les premiers mois décident de la suite, pour la personne comme pour l'organisation. Je prépare le manager dès la signature ou la nomination. Vous gardez la maîtrise du cadre, je prends en charge l'espace de travail individuel.", phrase: "Confirmer un recrutement, c'est l'accompagner après la signature." },
    { tag: "En poste depuis quelques mois", link: "/prise-de-poste", titre: "Votre prise de poste a soulevé des questions nouvelles.", desc: "Les premiers mois ont révélé des enjeux que la fiche de poste laissait dans l'ombre. C'est le bon moment pour faire le point : ce qui fonctionne, ce qui résiste, et la posture que vous voulez tenir désormais.", phrase: "Faire le point. Ajuster. S'installer durablement." }
  ];
  var cur=0, sc=[0,0,0,0], ans=[-1,-1,-1];

  function el(id){ return document.getElementById(id); }
  function render() {
    var q = Q[cur];
    el('diag-num').textContent = 'Question '+(cur+1)+' sur '+Q.length;
    el('diag-question').textContent = q.q;
    el('diag-bar').style.width = (cur/Q.length*100)+'%';
    var box = el('diag-options');
    box.innerHTML = '';
    q.opts.forEach(function(o, i) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'diag-opt' + (ans[cur]===i ? ' active' : '');
      var n = document.createElement('span'); n.className = 'opt-num'; n.textContent = i+1;
      var t = document.createElement('span'); t.className = 'opt-txt'; t.textContent = o.t;
      btn.appendChild(n); btn.appendChild(t);
      btn.onclick = function() { pick(i); };
      box.appendChild(btn);
    });
    var next = el('diag-next');
    next.disabled = ans[cur] < 0;
    next.textContent = cur === Q.length-1 ? 'Voir le résultat' : 'Continuer';
    el('diag-back').style.display = cur > 0 ? 'inline-block' : 'none';
    el('diag-result').style.display = 'none';
    box.style.display = 'flex';
    el('diag-nav').style.display = 'flex';
    el('diag-question').style.display = 'block';
    el('diag-num').style.display = 'block';
    el('diag-bar').parentElement.parentElement.style.display = 'flex';
  }
  function pick(i) {
    ans[cur] = i;
    document.querySelectorAll('.diag-opt').forEach(function(b, idx) { b.classList.toggle('active', idx === i); });
    el('diag-next').disabled = false;
  }
  window.diagNext = function() {
    if (ans[cur] < 0) return;
    Q[cur].opts[ans[cur]].s.forEach(function(v, i) { sc[i] += v; });
    if (cur < Q.length-1) { cur++; render(); } else { showResult(); }
  };
  window.diagBack = function() {
    if (cur === 0) return;
    Q[cur-1].opts[ans[cur-1]].s.forEach(function(v, i) { sc[i] -= v; });
    cur--; render();
  };
  window.diagRestart = function() { cur=0; sc=[0,0,0,0]; ans=[-1,-1,-1]; render(); };
  function showResult() {
    el('diag-bar').style.width = '100%';
    var best = 0;
    sc.forEach(function(v, i) { if (v > sc[best]) best = i; });
    var p = P[best];
    el('diag-tag').textContent = p.tag;
    el('diag-rtitle').textContent = p.titre;
    el('diag-rdesc').textContent = p.desc;
    el('diag-rphrase').textContent = p.phrase;
    el('diag-link').setAttribute('href', p.link);
    el('diag-options').style.display = 'none';
    el('diag-nav').style.display = 'none';
    el('diag-question').style.display = 'none';
    el('diag-num').style.display = 'none';
    el('diag-bar').parentElement.parentElement.style.display = 'none';
    el('diag-result').style.display = 'block';
  }
  render();
});
</script>

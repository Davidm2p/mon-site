</html>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var Q = [
    { q: "En réunion avec votre direction, une décision va pénaliser votre équipe. Le plus souvent :", opts: [
      { t: "Je me tais, et je défendrai mieux mon équipe la prochaine fois.", s: [5,0,0] },
      { t: "Je prévois déjà de compenser moi-même, en absorbant le surplus.", s: [0,5,0] },
      { t: "Je l'annoncerai à mon équipe en l'adoucissant beaucoup.", s: [0,0,5] }
    ]},
    { q: "Un dossier important arrive. Votre premier réflexe :", opts: [
      { t: "Le garder : ce sera plus rapide et mieux fait.", s: [0,5,0] },
      { t: "Accepter le délai imposé, même s'il est intenable.", s: [5,0,0] },
      { t: "Le confier à quelqu'un, mais sans oser fixer d'exigence claire.", s: [0,0,5] }
    ]},
    { q: "Un collaborateur ne tient pas ses engagements depuis plusieurs semaines :", opts: [
      { t: "Je repousse la conversation à la semaine prochaine.", s: [0,0,5] },
      { t: "Je rattrape son travail le soir.", s: [0,5,0] },
      { t: "Je n'ose pas en parler à ma direction, de peur que ça retombe sur moi.", s: [5,0,0] }
    ]},
    { q: "Ce qu'on vous reproche le plus souvent, ou que vous vous reprochez :", opts: [
      { t: "« Tu ne défends pas assez tes idées » ou « tu ne nous défends pas ».", s: [5,0,0] },
      { t: "« Tu veux tout faire toi-même. »", s: [0,5,0] },
      { t: "« Tu es trop gentil » ou « tu tardes à trancher ».", s: [0,0,5] }
    ]},
    { q: "Le soir, en repensant à votre journée, ce qui vous reste en travers :", opts: [
      { t: "L'idée que j'avais, et qu'un autre a portée.", s: [5,0,0] },
      { t: "Les tâches de mon équipe que j'ai encore faites à sa place.", s: [0,5,0] },
      { t: "Le « non » que je n'ai pas dit.", s: [0,0,5] }
    ]},
    { q: "Ce que vous remettez le plus souvent à demain :", opts: [
      { t: "Défendre une idée, mon équipe ou mes intérêts face à ma direction.", s: [5,0,0] },
      { t: "Confier un dossier, au lieu de le faire moi-même.", s: [0,5,0] },
      { t: "Dire ce qui va déplaire : un refus, un recadrage, une décision impopulaire.", s: [0,0,5] }
    ]}
  ];
  var P = [
    { tag: "Défendre", link: "/accompagnements", titre: "Vous portez les idées. Un autre les défend.", desc: "Vous savez ce qui serait juste pour votre équipe, et pour vous. Face à votre direction, vous attendez le bon moment, ou des arguments en béton. Ce n'est pas un manque de courage. C'est un réglage caché, et il se trouve.", phrase: "Votre idée était la bonne. Cette fois, c'est vous qui la défendez." },
    { tag: "Déléguer", link: "/accompagnements", titre: "Vous faites à la place.", desc: "Plus vite, mieux, sans avoir à expliquer. Vos soirées y passent, et votre équipe attend. Vous savez déléguer. Au moment de lâcher, quelque chose vous retient. C'est un réglage caché, et il se change.", phrase: "Lâcher un dossier, ce n'est pas lâcher votre équipe." },
    { tag: "Déplaire", link: "/accompagnements", titre: "Vous adoucissez.", desc: "Le refus devient un « on verra ». Le recadrage attend la semaine prochaine. Vous préservez la relation, et c'est justement elle qui s'use. C'est un réglage caché, et il se change.", phrase: "Agir n'abîme pas la relation. C'est ne pas agir qui l'use." }
  ];
  var cur=0, sc=[0,0,0], ans=[-1,-1,-1,-1,-1,-1];

  function el(id){ return document.getElementById(id); }
  function render() {
    var q = Q[cur];
    el('diag-num').textContent = 'Question '+(cur+1)+' sur '+Q.length;
    el('diag-question').textContent = q.q;
    el('diag-bar').style.width = (cur/Q.length*100)+'%';
    var box = el('diag-options');
    box.innerHTML = '';
    q.opts.forEach(function(o, i) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'diag-opt' + (ans[cur]===i ? ' active' : '');
      var n = document.createElement('span'); n.className = 'opt-num'; n.textContent = i+1;
      var t = document.createElement('span'); t.className = 'opt-txt'; t.textContent = o.t;
      btn.appendChild(n); btn.appendChild(t);
      btn.onclick = function() { pick(i); };
      box.appendChild(btn);
    });
    var next = el('diag-next');
    next.disabled = ans[cur] < 0;
    next.textContent = cur === Q.length-1 ? 'Voir le résultat' : 'Continuer';
    el('diag-back').style.display = cur > 0 ? 'inline-block' : 'none';
    el('diag-result').style.display = 'none';
    box.style.display = 'flex';
    el('diag-nav').style.display = 'flex';
    el('diag-question').style.display = 'block';
    el('diag-num').style.display = 'block';
    el('diag-bar').parentElement.parentElement.style.display = 'flex';
  }
  function pick(i) {
    ans[cur] = i;
    document.querySelectorAll('.diag-opt').forEach(function(b, idx) { b.classList.toggle('active', idx === i); });
    el('diag-next').disabled = false;
  }
  window.diagNext = function() {
    if (ans[cur] < 0) return;
    Q[cur].opts[ans[cur]].s.forEach(function(v, i) { sc[i] += v; });
    if (cur < Q.length-1) { cur++; render(); } else { showResult(); }
  };
  window.diagBack = function() {
    if (cur === 0) return;
    Q[cur-1].opts[ans[cur-1]].s.forEach(function(v, i) { sc[i] -= v; });
    cur--; render();
  };
  window.diagRestart = function() { cur=0; sc=[0,0,0]; ans=[-1,-1,-1,-1,-1,-1]; render(); };
  function showResult() {
    el('diag-bar').style.width = '100%';
    var best = 0;
    sc.forEach(function(v, i) { if (v > sc[best]) best = i; });
    var p = P[best];
    el('diag-tag').textContent = p.tag;
    el('diag-rtitle').textContent = p.titre;
    el('diag-rdesc').textContent = p.desc;
    el('diag-rphrase').textContent = p.phrase;
    el('diag-link').setAttribute('href', p.link);
    el('diag-options').style.display = 'none';
    el('diag-nav').style.display = 'none';
    el('diag-question').style.display = 'none';
    el('diag-num').style.display = 'none';
    el('diag-bar').parentElement.parentElement.style.display = 'none';
    el('diag-result').style.display = 'block';
  }
  render();
});
</script>

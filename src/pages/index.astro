---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
const SITE_TITLE = 'Coaching prise de poste manager | Coach certifié Montpellier et visio | M²P';
const SITE_DESCRIPTION = "Dès la signature ou la nomination, je prépare les managers à trouver leur place, et les organisations à confirmer leurs recrutements. Coach professionnel certifié. Visio France, présentiel Occitanie.";
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      img { display: block; max-width: 100%; height: auto; }
      :root {
        --fond: #F4F1EA;
        --anthracite: #535861;
        --sage: #7F9B88;
        --the: #A8B8A2;
        --ocre: #C99763;
        --ocre-h: #b07d45;
        --blanc: #ffffff;
      }
      .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
      h1, h2, h3 { font-family: 'Montserrat', sans-serif; }
      body { font-family: 'Inter', sans-serif; }
      .eyebrow { font-size: .72rem; text-transform: uppercase; letter-spacing: .14em; color: var(--sage); font-weight: 600; margin-bottom: .5rem; display: block; }
      .eyebrow-ocre { font-size: .72rem; text-transform: uppercase; letter-spacing: .14em; color: var(--ocre); font-weight: 600; margin-bottom: .5rem; display: block; text-align: center; }
      .btn-ocre { display: inline-block; align-self: center; background: var(--ocre); color: var(--blanc); padding: .95rem 2rem; border-radius: 0.5rem; text-decoration: none; font-weight: 600; font-size: .95rem; text-align: center; transition: background .2s; border: none; cursor: pointer; }
      .btn-ocre:hover { background: var(--ocre-h); color: var(--blanc); }
      .btn-block { display: block; width: 100%; margin-top: 1rem; }
      .btn-grand { font-size: 1.05rem; padding: 1.1rem 2.5rem; }
     .note { font-size: .75rem; color: #9A9590; margin-top: .6rem; text-align: center; }

      /* HERO */
      .hero { background: var(--anthracite); color: var(--fond); overflow: hidden; }
      .hero-inner { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; }
      .hero-photo-wrap { position: relative; width: 100%; order: -1; }
     .hero-photo { width: 100%; aspect-ratio: 16/9; object-fit: contain; object-position: center 25%; display: block; background: var(--anthracite); }
     .hero-texte { padding: 0 1.5rem 3rem; order: 1; text-align: center; display: flex; flex-direction: column; align-items: center; } .hero-texte a.btn-ocre { align-self: center; }
     .surtitre { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ocre); margin-bottom: .75rem; text-align: center; }
     .hero h1 { font-size: 2.2rem; font-weight: 700; line-height: 1.12; color: var(--fond); margin-bottom: 1.25rem; text-align: center; font-family: 'Montserrat', sans-serif; }
      .sous-titre { font-size: 1rem; color: #C9CCC4; margin-bottom: 2rem; font-style: italic; line-height: 1.6; text-align: center; }

      /* DIAGNOSTIC */
      .diagnostic { background: var(--fond); padding: 5rem 1.5rem; }
      .diag-h2 { font-size: 1.6rem; color: var(--anthracite); margin-bottom: 2.5rem; line-height: 1.25; font-weight: 700; text-align: center; }
      .diag-wrap { max-width: 620px; margin: 0 auto; }
      .diag-progress-row { display: flex; align-items: center; gap: 12px; margin-bottom: 1.5rem; }
      .diag-track { flex: 1; height: 6px; background: #DDD9D0; border-radius: 3px; overflow: hidden; }
      .diag-track div { height: 100%; width: 0; background: var(--ocre); border-radius: 3px; transition: width .4s ease; }
      .diag-step { font-size: .78rem; color: var(--sage); font-weight: 600; white-space: nowrap; margin: 0; }
      .diag-question { font-size: 1.2rem; font-weight: 700; color: var(--anthracite); line-height: 1.4; margin-bottom: 1.5rem; }

      /* OPTIONS */
      .diag-options { display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.5rem; }
      .diag-opt {
        display: flex; align-items: center; gap: 14px;
        background: var(--blanc);
        border: 2px solid #C8C3BA;
        border-radius: 12px;
        padding: 14px 18px;
        cursor: pointer; text-align: left; width: 100%;
        transition: border-color .18s, background .18s, transform .12s;
      }
      .diag-opt:hover { border-color: var(--ocre); background: #FDF0E0; transform: translateX(4px); }
      .diag-opt.active { border-color: var(--ocre); background: #FDF0E0; }
      .diag-opt.active .opt-num { background: var(--ocre); color: var(--blanc); }
      .opt-num {
        width: 32px; height: 32px; min-width: 32px;
        border-radius: 50%;
        background: var(--fond);
        color: var(--ocre);
        font-size: 13px; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        border: 2px solid var(--ocre);
        transition: background .18s, color .18s;
      }
      .opt-txt { font-size: 1rem; color: var(--anthracite); line-height: 1.4; font-weight: 500; }

      /* BOUTONS DIAGNOSTIC */
      .diag-nav { display: flex; gap: 10px; align-items: center; }
      .btn-continuer {
        flex: 1; background: var(--ocre); color: var(--blanc);
        border: none; border-radius: 50px;
        padding: .9rem 1.5rem; font-size: 1rem; font-weight: 600;
        cursor: pointer; transition: background .2s;
      }
      .btn-continuer:hover:not([disabled]) { background: var(--ocre-h); }
      .btn-continuer[disabled] { background: var(--anthracite); color: var(--ocre); cursor: not-allowed; }
      .btn-retour {
        background: transparent; border: 2px solid #C8C3BA;
        border-radius: 50px; padding: .9rem 1.25rem;
        font-size: .9rem; color: var(--sage); cursor: pointer;
      }
      .btn-retour:hover { border-color: var(--sage); }

      /* RÉSULTAT */
      .result-card { background: var(--blanc); border: 2px solid var(--ocre); border-radius: 16px; padding: 2rem 1.75rem; margin-bottom: 1.25rem; }
      .result-tag { display: inline-block; background: var(--ocre); color: var(--blanc); font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; padding: 4px 12px; border-radius: 50px; margin-bottom: 1rem; }
      .result-titre { font-size: 1.15rem; font-weight: 700; color: var(--anthracite); line-height: 1.3; margin-bottom: .75rem; }
      .result-desc { font-size: .95rem; color: #5A5F5B; line-height: 1.75; margin-bottom: 1.25rem; }
      .result-phrase { border-left: 3px solid var(--ocre); padding-left: 1rem; font-size: .92rem; color: var(--ocre-h); font-style: italic; line-height: 1.6; margin: 0; }
      .btn-restart { display: block; width: 100%; background: transparent; border: 2px solid #C8C3BA; border-radius: 50px; padding: .75rem; font-size: .88rem; color: var(--sage); cursor: pointer; margin-top: .75rem; }
      .btn-restart:hover { border-color: var(--sage); }

      /* RÉSULTATS CLIENTS */
      .resultats { background: var(--anthracite); padding: 5rem 1.5rem; }
      .resultats-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; max-width: 900px; margin: 2rem auto 0; }
      .resultat-item { display: flex; align-items: flex-start; gap: 1rem; background: rgba(255,255,255,.06); border-left: 3px solid var(--ocre); border-radius: 0 12px 12px 0; padding: 1.25rem 1.5rem; }
    .resultat-icone { font-size: 1.5rem; flex-shrink: 0; margin-top: .1rem; color: var(--ocre); }
      .resultat-texte { font-size: 1rem; color: var(--fond); line-height: 1.5; font-weight: 500; }
      .resultats h2 { font-size: 1.7rem; color: var(--fond); font-weight: 700; line-height: 1.2; text-align: center; }

      /* MÉTHODE */
      .methode { background: var(--blanc); padding: 5rem 1.5rem; }
      .methode-h2 { font-size: 1.7rem; color: var(--anthracite); margin-bottom: 2.5rem; line-height: 1.2; font-weight: 700; }
      .m2p-trio { display: flex; flex-direction: column; gap: 0; }
      .m2p-item { padding: 2.5rem 2rem; text-align: center; }
      .m2p-1 { background: var(--anthracite); }
      .m2p-2 { background: var(--sage); }
      .m2p-3 { background: var(--the); }
      .m2p-num { width: 64px; height: 64px; border-radius: 50%; background: rgba(255,255,255,.2); color: var(--blanc); font-size: 1.5rem; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; }
      .m2p-item h3 { font-size: 1.15rem; color: var(--blanc); margin-bottom: .5rem; font-weight: 700; }
      .m2p-item p { font-size: .95rem; color: rgba(255,255,255,.85); line-height: 1.6; margin: 0; }
      .m2p-arrow { text-align: center; font-size: 1.5rem; color: var(--ocre); padding: .5rem; transform: rotate(90deg); display: block; }

      /* CHIFFRES */
      .chiffres { background: var(--sage); padding: 5rem 1.5rem; }
      .chiffres-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; max-width: 800px; margin: 0 auto; }
      .chiffre-bloc { text-align: center; }
      .chiffre-n { display: block; font-size: 3rem; font-weight: 700; color: var(--blanc); line-height: 1; margin-bottom: .5rem; }
      .chiffre-l { display: block; font-size: .82rem; color: rgba(255,255,255,.85); text-transform: uppercase; letter-spacing: .08em; line-height: 1.4; }
      .chiffres-lien { text-align: center; margin-top: 3rem; }
      .chiffres-lien a { color: var(--fond); font-size: .9rem; text-decoration: none; border-bottom: 1px solid rgba(244,241,234,.4); padding-bottom: 2px; }
      .chiffres-lien a:hover { border-color: var(--fond); }

      /* AVIS */
      .avis-section { background: var(--fond); padding: 4rem 1.5rem; }
      .avis-card { max-width: 680px; margin: 0 auto; background: var(--blanc); border: 2px solid var(--ocre); border-radius: 16px; padding: 2rem 2rem 1.75rem; }
      .avis-etoiles { color: var(--ocre); font-size: 1.2rem; margin-bottom: 1rem; letter-spacing: .1em; }
      .avis-texte { font-size: 1rem; color: var(--anthracite); line-height: 1.75; font-style: italic; margin-bottom: 1.25rem; }
      .avis-auteur { font-size: .82rem; color: var(--sage); font-weight: 600; text-transform: uppercase; letter-spacing: .1em; }

      /* CTA FINAL */
      .cta-final { background: var(--fond); padding: 6rem 1.5rem; text-align: center; }
      .cta-phrase { font-size: 1.3rem; color: var(--anthracite); margin-bottom: 2rem; line-height: 1.6; font-style: italic; }

      /* RESPONSIVE */
      
      /* DEUX PORTES */
      .portes { background: var(--fond); padding: 4.5rem 1.5rem; }
      .portes-h2 { font-size: 1.6rem; color: var(--anthracite); font-weight: 700; line-height: 1.25; text-align: center; margin: 0 auto 2.5rem; max-width: 700px; }
      .portes-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; max-width: 960px; margin: 0 auto; }
      .porte { display: flex; flex-direction: column; background: var(--blanc); border-top: 4px solid var(--ocre); padding: 2rem 1.75rem; text-decoration: none; color: var(--anthracite); transition: box-shadow .2s; }
      .porte--orga { border-top-color: var(--sage); }
      .porte:hover, .porte:focus-visible { box-shadow: 0 6px 24px rgba(83,88,97,.14); }
      .porte:focus-visible { outline: 3px solid var(--ocre); outline-offset: 3px; }
      .porte-pour { font-size: .85rem; color: var(--sage); font-weight: 600; margin-bottom: .5rem; }
      .porte h3 { font-size: 1.3rem; font-weight: 700; line-height: 1.3; margin-bottom: .75rem; color: var(--anthracite); }
      .porte p { font-size: .95rem; line-height: 1.65; color: #4a4f4b; margin-bottom: 1.25rem; }
      .porte-lien { margin-top: auto; font-weight: 600; color: var(--ocre-h); font-size: .95rem; }

      /* LE SAS */
      .sas { background: var(--blanc); padding: 5rem 1.5rem; }
      .sas-h2 { font-size: 1.7rem; color: var(--anthracite); font-weight: 700; line-height: 1.25; margin-bottom: 1rem; max-width: 720px; }
      .sas-intro { font-size: 1rem; color: #4a4f4b; line-height: 1.7; max-width: 680px; margin-bottom: 3rem; }
      .sas-frise { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 0; counter-reset: sas; }
      .sas-etape { position: relative; padding: 0 0 2rem 3.25rem; counter-increment: sas; }
      .sas-etape::before { content: counter(sas); position: absolute; left: 0; top: 0; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--ocre); color: var(--blanc); font-weight: 700; display: flex; align-items: center; justify-content: center; font-family: 'Montserrat', sans-serif; }
      .sas-etape::after { content: ""; position: absolute; left: 1.1rem; top: 2.5rem; bottom: .25rem; width: 2px; background: #E4DED2; }
      .sas-etape:last-child::after { display: none; }
      .sas-etape:last-child::before { background: var(--sage); }
      .sas-etape h3 { font-size: 1.05rem; font-weight: 700; color: var(--anthracite); margin: .3rem 0 .4rem; }
      .sas-etape p { font-size: .93rem; color: #4a4f4b; line-height: 1.65; margin: 0; }

      @media (min-width: 860px) {
        .portes-grid { grid-template-columns: 1fr 1fr; }
        .sas-frise { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
        .sas-etape { padding: 3.25rem 0 0 0; }
        .sas-etape::after { left: 2.75rem; right: -1.25rem; top: 1.1rem; bottom: auto; width: auto; height: 2px; }
        .m2p-trio { flex-direction: row; }
        .m2p-item { flex: 1; }
        .m2p-arrow { transform: none; align-self: center; }
      }

      @media (min-width: 860px) {
  .hero-inner {
    flex-direction: row;
    align-items: stretch;
    min-height: 580px;
  }
  .hero-texte {
    flex: 1 1 0%;
    min-width: 0;
    overflow: hidden;
    padding: 3rem 4rem 3rem 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    order: 0;
  }
  .hero-photo-wrap { width: 300px; flex-shrink: 0; overflow: hidden; position: relative; order: 1; }
  .hero-photo { width: 100%; height: 100%; aspect-ratio: unset; object-fit: cover; object-position: center 12%; display: block; }
  .hero h1 {
    font-size: 2.6rem;
  }
}
    </style>
  </head>
  <body>
    <Header />
    <main>

      <!-- HERO -->
      <section class="hero">
        <div class="hero-inner">
          <div class="hero-texte">
            <p class="surtitre">Coach professionnel certifié · 22 ans d'expérience en recrutement et développement RH</p>
            <h1>Pour le manager : trouver sa place. Pour l'organisation : confirmer son recrutement.</h1>
            <p class="sous-titre">Dès la signature ou la nomination, je prépare les managers promus ou recrutés à prendre leur poste. Mon rôle commence là où le recrutement s'achève.</p>
            <a href="https://thecoachpilot.com/book/david-delord/echange-decouverte-30-min-m-p-coaching" target="_blank" rel="noopener" class="btn-ocre" style="display:block; margin:0 auto; width:fit-content;">
              Réserver un échange de 30 minutes
            </a>
            <p class="note">Sans engagement · Visio France entière ou présentiel Occitanie</p>
          </div>
          <div class="hero-photo-wrap">
            <img src="/david.jpg" alt="David Delord, coach professionnel certifié" class="hero-photo" loading="eager" />
          </div>
        </div>
      </section>

      <!-- DEUX PORTES -->
      <section class="portes">
        <div class="container">
          <h2 class="portes-h2">Une même prise de poste, deux façons de la vivre.</h2>
          <div class="portes-grid">
            <a href="/prise-de-poste" class="porte">
              <span class="porte-pour">Pour le manager</span>
              <h3>Vous prenez un poste de manager.</h3>
              <p>Promu en interne ou recruté à l'extérieur, vous préparez votre arrivée et vos premiers mois. Vous posez les intentions qui vous permettront de trouver votre place.</p>
              <span class="porte-lien">Préparer ma prise de poste</span>
            </a>
            <a href="/organisations" class="porte porte--orga">
              <span class="porte-pour">Pour les RH et les dirigeants</span>
              <h3>Vous recrutez ou promouvez un manager.</h3>
              <p>Votre décision est prise. Les premiers mois vont la confirmer. Vous donnez au manager qui arrive un espace pour s'installer dans son rôle.</p>
              <span class="porte-lien">Accompagner un manager</span>
            </a>
          </div>
        </div>
      </section>

      <!-- LE SAS -->
      <section class="sas">
        <div class="container">
          <h2 class="sas-h2">Entre la signature et les premiers mois, une place se construit.</h2>
          <p class="sas-intro">Un recrutement se décide en quelques semaines. Il se confirme sur le terrain. C'est dans cet entre-deux que je travaille avec le manager, étape par étape.</p>
          <ol class="sas-frise">
            <li class="sas-etape">
              <h3>La signature ou la nomination</h3>
              <p>Le poste est acquis. Un temps de préparation s'ouvre : vous clarifiez ce que vous voulez installer et dans quel ordre.</p>
            </li>
            <li class="sas-etape">
              <h3>L'arrivée</h3>
              <p>Premières rencontres, premières impressions. Vous observez le terrain avec des repères clairs avant d'agir.</p>
            </li>
            <li class="sas-etape">
              <h3>Les premiers mois</h3>
              <p>Les attentes implicites apparaissent. Vous ajustez votre posture au réel de l'équipe et de l'organisation.</p>
            </li>
            <li class="sas-etape">
              <h3>La confirmation</h3>
              <p>Pour le manager, une place trouvée. Pour l'organisation, un recrutement confirmé.</p>
            </li>
          </ol>
        </div>
      </section>

      <!-- DIAGNOSTIC -->
      <section class="diagnostic">
        <div class="container">
          <p class="eyebrow-ocre">Et vous, où en êtes-vous ?</p>
          <h2 class="diag-h2">Trois questions pour situer votre prise de poste.</h2>
          <div class="diag-wrap">
            <div class="diag-progress-row">
              <div class="diag-track"><div id="diag-bar"></div></div>
              <p id="diag-num" class="diag-step"></p>
            </div>
            <p id="diag-question" class="diag-question"></p>
            <div id="diag-options" class="diag-options"></div>
            <div class="diag-nav" id="diag-nav">
              <button id="diag-back" class="btn-retour" onclick="diagBack()" style="display:none">Retour</button>
              <button id="diag-next" class="btn-continuer" onclick="diagNext()" disabled>Continuer</button>
            </div>
            <div id="diag-result" style="display:none">
              <div class="result-card">
                <span id="diag-tag" class="result-tag"></span>
                <p id="diag-rtitle" class="result-titre"></p>
                <p id="diag-rdesc" class="result-desc"></p>
                <p id="diag-rphrase" class="result-phrase"></p>
              </div>
              <a id="diag-link" href="/prise-de-poste" class="btn-ocre btn-block">Voir la page qui vous concerne</a>
              <button class="btn-restart" onclick="diagRestart()">Recommencer</button>
            </div>
          </div>
        </div>
      </section>

      <!-- CE QUE LA PRISE DE POSTE DEVIENT -->
      <section class="resultats">
        <div class="container">
          <p class="eyebrow-ocre" style="color: var(--the);">Ce que les managers construisent</p>
          <h2>Une prise de poste préparée, une place tenue dans la durée.</h2>
          <div class="resultats-grid">
            <div class="resultat-item"><span class="resultat-icone" aria-hidden="true">✓</span><p class="resultat-texte">Ils arrivent dans leur poste avec des intentions claires et un ordre de priorités.</p></div>
            <div class="resultat-item"><span class="resultat-icone" aria-hidden="true">✓</span><p class="resultat-texte">Ils trouvent le ton juste avec leur équipe, y compris avec d'anciens collègues.</p></div>
            <div class="resultat-item"><span class="resultat-icone" aria-hidden="true">✓</span><p class="resultat-texte">Ils construisent leur légitimité par leurs actes et leurs décisions.</p></div>
            <div class="resultat-item"><span class="resultat-icone" aria-hidden="true">✓</span><p class="resultat-texte">Ils repèrent les attentes implicites et y répondent en conscience.</p></div>
            <div class="resultat-item"><span class="resultat-icone" aria-hidden="true">✓</span><p class="resultat-texte">Ils tiennent leur posture dans la durée, par eux-mêmes. C'est l'objectif du coaching.</p></div>
          </div>
        </div>
      </section>

      <!-- MÉTHODE -->
      <section class="methode">
        <div class="container">
          <p class="eyebrow">La méthode</p>
          <h2 class="methode-h2">M²P : Maîtrise. Mouvement. Progression.</h2>
          <div class="m2p-trio">
            <div class="m2p-item m2p-1">
              <div class="m2p-num">M</div>
              <h3>Maîtrise</h3>
              <p>Vous nommez ce qui se joue dans ce nouveau rôle. Vos intentions deviennent claires avant d'agir.</p>
            </div>
            <div class="m2p-arrow" aria-hidden="true">→</div>
            <div class="m2p-item m2p-2">
              <div class="m2p-num">M</div>
              <h3>Mouvement</h3>
              <p>Vous passez de l'intention à l'action sur le terrain. Je tiens le cadre, vous trouvez votre voie.</p>
            </div>
            <div class="m2p-arrow" aria-hidden="true">→</div>
            <div class="m2p-item m2p-3">
              <div class="m2p-num">P</div>
              <h3>Progression</h3>
              <p>Vous ancrez votre posture et avancez par vous-même. C'est l'objectif.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CHIFFRES -->
      <section class="chiffres">
        <div class="container">
          <div class="chiffres-grid">
            <div class="chiffre-bloc">
              <span class="chiffre-n">22</span>
              <span class="chiffre-l">ans d'expérience en recrutement et développement RH</span>
            </div>
            <div class="chiffre-bloc">
              <span class="chiffre-n">2</span>
              <span class="chiffre-l">côtés de la relation : celui qui recrute, celui qui arrive</span>
            </div>
            <div class="chiffre-bloc">
              <span class="chiffre-n">100 %</span>

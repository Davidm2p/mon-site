<script>
document.addEventListener('DOMContentLoaded', function() {
  var Q = [
    { q: "En réunion de direction, on fixe à votre équipe un objectif que vous jugez irréaliste :", opts: [
      { t: "Je ne dis rien : ce n'est pas le moment de contester.", s: [5, 0, 0] },
      { t: "J'en prendrai une bonne partie moi-même pour soulager l'équipe.", s: [0, 5, 0] },
      { t: "Je l'annoncerai à l'équipe en l'enrobant, pour ne pas la braquer.", s: [0, 0, 5] }
    ]},
    { q: "Une personne de votre équipe vous demande de modifier le planning la semaine prochaine. La décision vous revient :", opts: [
      { t: "Je demande l'aval de ma hiérarchie avant de répondre, même si c'est à moi de trancher.", s: [5, 0, 0] },
      { t: "Je refais le planning moi-même, plutôt que de laisser l'équipe proposer une solution.", s: [0, 5, 0] },
      { t: "Je dis oui, même si ça désorganise le service, pour ne pas la décevoir.", s: [0, 0, 5] }
    ]},
    { q: "Un dossier urgent arrive, avec un délai serré :", opts: [
      { t: "J'accepte le délai, même si je sais qu'il va déborder sur mes soirées.", s: [5, 0, 0] },
      { t: "Je le traite moi-même : expliquer prendrait plus de temps.", s: [0, 5, 0] },
      { t: "Je le confie à celui qui ne protestera pas, plutôt qu'à celui qui serait le plus indiqué.", s: [0, 0, 5] }
    ]},
    { q: "Une personne de votre équipe ne tient pas ses engagements depuis plusieurs semaines :", opts: [
      { t: "Je revois mes exigences à la baisse, pour que ça passe.", s: [5, 0, 0] },
      { t: "Je lui reprends le dossier, sans lui avoir vraiment dit ce que j'attendais.", s: [0, 5, 0] },
      { t: "Je repousse la conversation, pour ne pas abîmer la relation.", s: [0, 0, 5] }
    ]},
    { q: "Un projet transverse est lancé, et votre service doit y contribuer :", opts: [
      { t: "J'accepte la charge demandée, sans négocier les moyens qui vont avec.", s: [5, 0, 0] },
      { t: "Je le porte moi-même, plutôt que de le confier à une personne de l'équipe qui grandirait avec.", s: [0, 5, 0] },
      { t: "J'attends le dernier moment pour annoncer cette charge en plus à l'équipe.", s: [0, 0, 5] }
    ]},
    { q: "À votre entretien annuel, ce que votre N+1 vous dit :", opts: [
      { t: "« Prends plus de place en comité. Défends davantage tes positions. Développe ton leadership. »", s: [5, 0, 0] },
      { t: "« Sors de l'opérationnel. Fais monter ton équipe. »", s: [0, 5, 0] },
      { t: "« Sois plus ferme. Tranche plus vite. »", s: [0, 0, 5] }
    ]},
    { q: "Le dimanche soir, ce qui vous occupe l'esprit :", opts: [
      { t: "Le temps que je n'ai pas su garder pour moi, encore cette semaine.", s: [5, 0, 0] },
      { t: "Les dossiers de l'équipe qui m'attendent, parce que je les ai gardés.", s: [0, 5, 0] },
      { t: "La conversation que je repousse depuis des semaines.", s: [0, 0, 5] }
    ]}
  ];
  var P = [
    { tag: "Défendre", link: "https://portail.m2p-coaching.fr/analyse-defendre", titre: "Vous cédez du terrain.", desc: "Face à votre direction, vous gardez vos idées pour vous. Face à votre équipe, vous attendez d'avoir des arguments en béton pour trancher. Face à vous-même, vous laissez filer vos soirées et vos priorités. Le courage, vous l'avez. Au moment de prendre la parole, un réglage caché vous retient.", aide: "En coaching, nous repérons ensemble ce réglage : la règle intérieure qui vous fait céder. Vous testez ensuite une autre façon de faire, sur une situation réelle de votre semaine. Vous prenez votre place en comité, vous défendez vos positions et votre leadership s'affirme.", phrase: "Défendre, c'est aussi tenir pour vous ce que vous tenez pour les autres." },
    { tag: "Déléguer", link: "https://portail.m2p-coaching.fr/analyse-deleguer", titre: "Vous faites à la place.", desc: "Vous traitez les dossiers vous-même : c'est plus rapide, c'est mieux fait, et vous n'avez rien à expliquer. Vos soirées y passent. Votre équipe attend vos décisions et gagne moins vite en autonomie. Déléguer, vous savez faire. Au moment de lâcher, un réglage caché vous retient.", aide: "En coaching, nous identifions ensemble ce qui vous retient au moment de confier. Vous choisissez un dossier réel et vous le déléguez autrement, étape par étape. Vous sortez de l'opérationnel, votre équipe prend de l'autonomie et vous retrouvez du temps pour votre rôle de manager.", phrase: "Lâcher un dossier, ce n'est pas lâcher votre équipe." },
    { tag: "Déplaire", link: "https://portail.m2p-coaching.fr/analyse-deplaire", titre: "Vous adoucissez.", desc: "Votre refus devient un « on verra ». Le recadrage attend la semaine prochaine. La décision difficile attend le bon moment. Vous protégez la relation, et c'est justement elle qui s'use. Au moment de trancher, un réglage caché vous fait adoucir.", aide: "En coaching, nous mettons au jour la règle qui vous pousse à adoucir. Vous préparez la conversation que vous repoussez, puis vous la menez. Vous gagnez en fermeté, vous tranchez plus vite et la relation avec votre équipe en sort renforcée.", phrase: "Agir n'abîme pas la relation. C'est ne pas agir qui l'use." }
  ];
  var cur=0, sc=[0,0,0], ans=[-1,-1,-1,-1,-1,-1,-1], ordre=[];
  function melange(t) { for (var k = t.length - 1; k > 0; k--) { var j = Math.floor(Math.random() * (k + 1)); var x = t[k]; t[k] = t[j]; t[j] = x; } return t; }

  function el(id){ return document.getElementById(id); }
  function render() {
    var q = Q[cur];
    el('diag-num').textContent = 'Question '+(cur+1)+' sur '+Q.length;
    el('diag-question').textContent = q.q;
    el('diag-bar').style.width = (cur/Q.length*100)+'%';
    var box = el('diag-options');
    box.innerHTML = '';
    if (!ordre[cur]) { ordre[cur] = melange(q.opts.map(function(_, k) { return k; })); }
    ordre[cur].forEach(function(i, pos) {
      var o = q.opts[i];
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.k = i;
      btn.className = 'diag-opt' + (ans[cur]===i ? ' active' : '');
      var n = document.createElement('span'); n.className = 'opt-num'; n.textContent = pos+1;
      var t = document.createElement('span'); t.className = 'opt-txt'; t.textContent = o.t;
      btn.appendChild(n); btn.appendChild(t);
      btn.onclick = function() { pick(i); };
      box.appendChild(btn);
    });
    var next = el('diag-next');
    next.disabled = ans[cur] < 0;
    next.textContent = cur === Q.length-1 ? 'Voir le résultat' : 'Continuer';
    el('diag-back').style.display = cur > 0 ? 'inline-block' : 'none';
    el('diag-result').style.display = 'none';
    box.style.display = 'flex';
    el('diag-nav').style.display = 'flex';
    el('diag-question').style.display = 'block';
    el('diag-num').style.display = 'block';
    el('diag-bar').parentElement.parentElement.style.display = 'flex';
  }
  function pick(i) {
    ans[cur] = i;
    document.querySelectorAll('.diag-opt').forEach(function(b, idx) { b.classList.toggle('active', Number(b.dataset.k) === i); });
    el('diag-next').disabled = false;
  }
  window.diagNext = function() {
    if (ans[cur] < 0) return;
    Q[cur].opts[ans[cur]].s.forEach(function(v, i) { sc[i] += v; });
    if (cur < Q.length-1) { cur++; render(); } else { showResult(); }
  };
  window.diagBack = function() {
    if (cur === 0) return;
    Q[cur-1].opts[ans[cur-1]].s.forEach(function(v, i) { sc[i] -= v; });
    cur--; render();
  };
  window.diagRestart = function() { cur=0; sc=[0,0,0]; ans=[-1,-1,-1,-1,-1,-1,-1]; ordre=[]; render(); };
  function showResult() {
    el('diag-bar').style.width = '100%';
    var total = sc.reduce(function(x, y) { return x + y; }, 0) || 1;
    var max = Math.max.apply(null, sc);
    var box = el('diag-scores'); box.innerHTML = '';
    var titre = document.createElement('p'); titre.className = 'scores-titre'; titre.textContent = 'Vos 3 D';
    box.appendChild(titre);
    P.forEach(function(p, i) {
      var pct = Math.round(sc[i] / total * 100);
      var row = document.createElement('div'); row.className = 'score-row' + (sc[i] === max ? ' score-row--top' : '');
      var lab = document.createElement('span'); lab.className = 'score-lab'; lab.textContent = p.tag;
      var tr = document.createElement('span'); tr.className = 'score-track';
      var fill = document.createElement('span'); fill.className = 'score-fill'; fill.style.width = pct + '%';
      tr.appendChild(fill);
      var val = document.createElement('span'); val.className = 'score-val'; val.textContent = pct + ' %';
      row.appendChild(lab); row.appendChild(tr); row.appendChild(val); box.appendChild(row);
    });
    var cards = el('diag-cards'); cards.innerHTML = '';
    P.forEach(function(p, i) {
      if (sc[i] !== max) return;
      var c = document.createElement('div'); c.className = 'result-card';
      [['span','result-tag',p.tag],['p','result-titre',p.titre],['p','result-desc',p.desc],['p','result-label','Ce que le coaching change'],['p','result-desc',p.aide],['p','result-phrase',p.phrase]].forEach(function(d) {
        var e = document.createElement(d[0]); e.className = d[1]; e.textContent = d[2]; c.appendChild(e);
      });
      cards.appendChild(c);
    });
    var top = sc.indexOf(max);
    var lien = el('diag-link');
    var slug = function(t) { return t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); };
    var url = function(i) { return P[i].link + '?utm_source=site&utm_medium=test-3d&utm_campaign=' + encodeURIComponent(slug(P[i].tag)); };
    document.querySelectorAll('.diag-link-extra').forEach(function(x) { x.remove(); });
    var egaux = [];
    sc.forEach(function(v, i) { if (v === max) egaux.push(i); });
    lien.href = url(top);
    lien.textContent = (egaux.length > 1 ? "Recevoir l'analyse : " : 'Recevoir mon analyse détaillée : ') + P[top].tag;
    var prev = lien;
    egaux.slice(1).forEach(function(i) {
      var a = lien.cloneNode(false); a.removeAttribute('id'); a.classList.add('diag-link-extra');
      a.href = url(i); a.textContent = "Recevoir l'analyse : " + P[i].tag;
      prev.insertAdjacentElement('afterend', a); prev = a;
    });
    if (window.gtag) { gtag('event', 'test_3d_resultat', { d_dominant: egaux.map(function(i) { return P[i].tag; }).join('+') }); }
    var concernes = sc.filter(function(v) { return v / total >= 0.3; }).length;
    el('diag-note').textContent = concernes > 1
      ? "Plusieurs D ressortent : le réglage joue sur l'ensemble de votre rôle. C'est le terrain d'Ancrage, l'accompagnement sur 6 mois."
      : "Un D ressort nettement : une situation précise vous bloque. C'est le terrain de Déclic, l'accompagnement sur 4 mois.";
    el('diag-options').style.display = 'none';
    el('diag-nav').style.display = 'none';
    el('diag-question').style.display = 'none';
    el('diag-num').style.display = 'none';
    el('diag-bar').parentElement.parentElement.style.display = 'none';
    el('diag-result').style.display = 'block';
  }
  render();
});
</script>

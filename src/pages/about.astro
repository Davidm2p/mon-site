---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const SITE_TITLE = "David Delord · Coach Professionnel Certifié | M²P Coaching";
const SITE_DESCRIPTION = "22 ans de terrain RH, dont une expérience de responsable RH recrutement dans un groupe de santé privée multi-sites. Aujourd'hui coach certifié. C'est ça qui change tout.";
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>

      <!-- ════════════════════════════════
           HERO ABOUT - sobre, textuel
           ════════════════════════════════ -->
      <section class="about-hero" style="background: #535861; color: #F4F1EA;">
        <div class="container">
          <p class="label">David Delord</p>
          <h1>22 ans de terrain RH.<br/> Aujourd'hui coach certifié.<br/> C'est ça qui change tout.</h1>
          <p class="hero-sous">Je ne viens pas du monde du coaching. Je viens du terrain. C'est ce qui change tout.</p>
        </div>
      </section>

      <!-- ════════════════════════════════
           SECTION PHILOSOPHIE
           ════════════════════════════════ -->
      <section class="philosophie">
        <div class="container philo-grid">

          <div class="philo-texte">
            <p class="label">Ma philosophie</p>
            <h2>Je suis architecte du cadre. Pas conseiller.</h2>
            <p>Mon approche est humaniste non-directive. Ce que cela signifie concrètement : je ne vous dis pas quoi faire. Je ne trace pas votre chemin. Je construis l'espace dans lequel vous retrouvez votre propre puissance d'agir.</p>
            <p>Ma conviction profonde : vous avez déjà les ressources. Ce qui manque, c'est un cadre rigoureux pour les mobiliser, sans la pression du quotidien, sans l'injonction de performance immédiate, sans avoir à justifier chaque doute.</p>
            <p>La réussite de mon intervention se mesure à un seul indicateur : à la fin du parcours, vous n'avez plus besoin de moi.</p>
          </div>

          <div class="philo-citation">
            <blockquote>
              <p>"Je ne décide pas à votre place. Je crée le cadre dans lequel vous trouvez votre direction."</p>
            </blockquote>
            <div class="philo-valeurs">
              <div class="valeur-item">
                <span class="valeur-dot"></span>
                <span>Primauté de l'individu sur le système</span>
              </div>
              <div class="valeur-item">
                <span class="valeur-dot"></span>
                <span>Autonomie comme horizon, pas comme point de départ</span>
              </div>
              <div class="valeur-item">
                <span class="valeur-dot"></span>
                <span>Étanchéité absolue entre la séance et l'institution</span>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ════════════════════════════════
           PARCOURS RH CHRONOLOGIQUE
           ════════════════════════════════ -->
      <section class="parcours">
        <div class="container">
          <p class="label label-gold">Parcours</p>
          <h2>22 ans de terrain. Avant d'être coach, j'étais de l'autre côté.</h2>
          <p class="parcours-intro">J'ai démarré ma carrière comme chargé de recrutement chez Randstad en 2002. Consultant senior, puis responsable d'agence. Vingt ans à comprendre les organisations de l'intérieur, à travailler avec des cadres dans des environnements exigeants. Ce que j'y ai appris ne s'enseigne pas en formation.</p>

          <div class="timeline">

            <div class="tl-item">
              <div class="tl-marqueur">
                <div class="tl-point"></div>
                <div class="tl-ligne"></div>
              </div>
              <div class="tl-contenu">
                <p class="tl-periode">2002-2010</p>
                <h3>Les fondations RH · Randstad</h3>
                <p>Chargé de recrutement. Construction progressive d'une expertise terrain : sourcing, évaluation, accompagnement des candidats et des clients. Apprentissage des codes, des tensions, des non-dits des organisations.</p>
              </div>
            </div>

            <div class="tl-item">
              <div class="tl-marqueur">
                <div class="tl-point"></div>
                <div class="tl-ligne"></div>
              </div>
              <div class="tl-contenu">
                <p class="tl-periode">2010-2021</p>
                <h3>Consultant Senior · Randstad</h3>
                <p>Accompagnement de clients sur des enjeux RH complexes. Développement d'une lecture fine des organisations et de leurs dynamiques humaines. Travail au quotidien avec des cadres et managers dans des environnements exigeants.</p>
              </div>
            </div>

            <div class="tl-item">
              <div class="tl-marqueur">
                <div class="tl-point"></div>
                <div class="tl-ligne"></div>
              </div>
              <div class="tl-contenu">
                <p class="tl-periode">2021-2023</p>
                <h3>Responsable d'Agence · Randstad</h3>
                <p>Pilotage d'une agence, management d'équipe, développement commercial et gestion des relations clients. Responsabilité d'un centre de profit avec des objectifs de performance et de satisfaction client.</p>
              </div>
            </div>

            <div class="tl-item">
              <div class="tl-marqueur">
                <div class="tl-point"></div>
                <div class="tl-ligne"></div>
              </div>
              <div class="tl-contenu">
                <p class="tl-periode">2023-2025</p>
                <h3>Responsable RH Recrutement & Développement · Clinipole</h3>
                <p>Groupe de santé privée multi-sites. Refonte complète des politiques de recrutement du groupe. Travail sur l'attractivité, la marque employeur, la QVT et la politique handicap. Environ 250 recrutements par an. Ce parcours m'a donné une chose rare : la capacité à lire une organisation, ses tensions et ses enjeux humains, sans qu'on ait besoin de me les expliquer.</p>
              </div>
            </div>

            <div class="tl-item tl-item-final">
              <div class="tl-marqueur">
                <div class="tl-point tl-point-or"></div>
              </div>
              <div class="tl-contenu">
                <p class="tl-periode">Aujourd'hui</p>
                <h3>M²P Coaching & Développement</h3>
                <p>Au fil des années, j'ai occupé une position particulière dans les organisations. Celle de quelqu'un à qui on parle vraiment. Pas la version officielle. La version réelle. J'ai vu des cadres compétents douter en silence. Des dirigeants performants s'isoler progressivement. Des professionnels talentueux avancer sans jamais vraiment choisir leur direction. C'est cette réalité qui m'a amené au coaching. L'envie de créer un espace où ce qui se joue vraiment peut enfin être regardé en face, et transformé en mouvement.</p>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- ════════════════════════════════
           FAQ
           ════════════════════════════════ -->
      <section class="faq">
        <div class="container">
          <p class="label">Questions fréquentes</p>

          <div class="faq-block faq-block--concret">
            <h2 class="faq-block-title">Le coaching, concrètement</h2>
            <div class="faq-list">
              <details class="faq-item">
                <summary>Qu'est-ce qu'un coach humaniste non directif, concrètement ?</summary>
                <p>Je ne vous apporte pas de solutions toutes faites. Mon rôle consiste à poser un cadre clair et à mener une écoute exigeante, pour que vos propres réponses émergent. Vous restez l'auteur de vos décisions, du premier au dernier échange.</p>
              </details>
              <details class="faq-item">
                <summary>Le coaching remplace-t-il une thérapie ?</summary>
                <p>Le coaching porte sur un objectif présent et sur l'action, professionnelle ou personnelle. Un suivi thérapeutique explore davantage le passé et le fonctionnement psychique. Les deux démarches peuvent se compléter selon votre situation.</p>
              </details>
              <details class="faq-item">
                <summary>Travaillez-vous pour moi, ou pour l'organisation qui finance l'accompagnement ?</summary>
                <p>Mon engagement va dans un seul sens, vers vous et vers l'atteinte de votre objectif. Même dans le cadre d'un contrat tripartite avec votre organisation, ce qui se dit en séance reste strictement entre nous. Aucun compte rendu de contenu n'est transmis à votre direction ou à vos RH.</p>
              </details>
              <details class="faq-item">
                <summary>Faut-il déjà savoir précisément ce que je veux travailler avant de commencer ?</summary>
                <p>Beaucoup de personnes viennent avec une intuition plutôt qu'un objectif formulé. Le premier échange sert justement à clarifier ensemble votre situation réelle et à poser un objectif de travail concret, avant tout engagement.</p>
              </details>
              <details class="faq-item">
                <summary>Pourquoi un parcours structuré plutôt qu'une séance ponctuelle ?</summary>
                <p>Un parcours en plusieurs séances permet d'aller en profondeur sur une problématique, de mesurer une vraie progression, et d'ancrer les changements dans la durée. Une séance isolée reste utile pour une question précise et immédiate.</p>
              </details>
              <details class="faq-item">
                <summary>Comment l'accompagnement s'organise-t-il avec un emploi du temps chargé ?</summary>
                <p>Le rythme des séances se cale sur votre disponibilité réelle, généralement toutes les deux à trois semaines. La structure du parcours reste stable, le tempo s'adapte à vous.</p>
              </details>
              <details class="faq-item">
                <summary>Combien de temps avant de percevoir des premiers changements ?</summary>
                <p>Chaque situation reste unique, mais la plupart des personnes accompagnées identifient des premiers changements concrets dès les toutes premières séances, une clarté retrouvée sur une décision, une posture qui se stabilise.</p>
              </details>
              <details class="faq-item">
                <summary>Comment se passe la confidentialité dans le cadre d'un accompagnement financé par mon organisation ?</summary>
                <p>L'étanchéité entre la séance et l'institution reste absolue. Seuls les objectifs généraux du parcours peuvent être partagés avec votre organisation si vous le souhaitez, jamais le contenu des séances.</p>
              </details>
              <details class="faq-item">
                <summary>Visio ou présentiel ?</summary>
                <p>Les séances se déroulent en visio pour la France entière, ou en présentiel en Occitanie, selon votre préférence.</p>
              </details>
            </div>
            <p class="faq-cta"><a href="https://thecoachpilot.com/book/david-delord/echange-decouverte-30-min-m-p-coaching" target="_blank" rel="noopener">Une question ne trouve pas sa réponse ici ? Réservez un premier échange de 30 minutes →</a></p>
          </div>

          <div class="faq-block faq-block--methode">
            <h2 class="faq-block-title">La méthode M²P en bref</h2>
            <div class="faq-list">
              <details class="faq-item faq-item--methode">
                <summary>En quoi consiste la méthode M²P ?</summary>
                <div class="methode-etapes">
                  <span class="etape etape--maitrise">Maîtrise</span>
                  <span class="etape etape--mouvement">Mouvement</span>
                  <span class="etape etape--progression">Progression</span>
                </div>
                <p>M²P structure l'accompagnement en trois temps. <strong>Maîtrise</strong> pose un diagnostic clair de votre situation et de vos marges de manœuvre réelles. <strong>Mouvement</strong> engage l'action sur les décisions ou postures à faire évoluer. <strong>Progression</strong> stabilise ces changements dans la durée, pour qu'ils tiennent au delà de nos séances. L'objectif reste le même à chaque étape, diriger avec clarté, et rester aligné avec ce qui compte pour vous.</p>
              </details>
            </div>
            <p class="faq-cta"><a href="https://thecoachpilot.com/book/david-delord/echange-decouverte-30-min-m-p-coaching" target="_blank" rel="noopener">Vous voulez savoir comment cette méthode s'applique à votre situation ? Réservez un premier échange →</a></p>
          </div>

          <div class="faq-block faq-block--cadre">
            <h2 class="faq-block-title">Éthique, cadre professionnel et financement</h2>
            <div class="faq-list">
              <details class="faq-item">
                <summary>Le métier de coach est-il réglementé ?</summary>
                <p>Non, le coaching reste un secteur non réglementé en France, n'importe qui peut se déclarer coach sans formation ni contrôle. C'est pour cette raison que la pratique supervisée et l'engagement sur une charte éthique deviennent les seuls repères objectifs pour distinguer une pratique sérieuse.</p>
              </details>
              <details class="faq-item">
                <summary>Qu'est-ce que la supervision, et pourquoi vous l'imposez-vous ?</summary>
                <p>La supervision consiste à faire réviser régulièrement ma pratique par un coach senior, extérieur à mes accompagnements. Ce n'est pas une obligation légale, mais une exigence éthique que je m'impose mensuellement pour garantir que mon regard reste neutre, et que mon passé de professionnel RH n'interfère jamais avec votre accompagnement.</p>
              </details>
              <details class="faq-item">
                <summary>Sur quels principes déontologiques vous engagez-vous ?</summary>
                <p>Je souscris formellement à la Charte Éthique du Coaching, respect absolu de votre autonomie, absence de toute manipulation, clarté sur les rôles et les limites de mon intervention.</p>
              </details>
              <details class="faq-item">
                <summary>Êtes-vous assuré pour cette activité ?</summary>
                <p>Oui, une responsabilité civile professionnelle est souscrite pour l'ensemble de mes accompagnements, dans le cadre de la SASU M²P Coaching et Développement.</p>
              </details>
              <details class="faq-item">
                <summary>Quelle est la différence entre coaching, conseil et formation ?</summary>
                <p>Le coaching ne consiste ni à transmettre un savoir, ce qui relève de la formation, ni à recommander une solution experte, ce qui relève du conseil. Il s'agit de créer un cadre dans lequel vous trouvez vos propres réponses, à votre rythme, sur vos propres problématiques.</p>
              </details>
              <details class="faq-item">
                <summary>Le CPF peut-il financer un accompagnement avec vous ?</summary>
                <p>Non. Le CPF finance uniquement des formations certifiantes inscrites au RNCP ou au Répertoire Spécifique, pas un accompagnement individuel de coaching. Si votre organisation prend en charge la démarche, elle peut en revanche financer directement les séances dans le cadre d'un contrat professionnel, en dehors des dispositifs CPF.</p>
              </details>
              <details class="faq-item">
                <summary>Que se passe-t-il si je souhaite arrêter en cours de parcours ?</summary>
                <p>Vous restez libre à tout moment. Si vous décidez d'arrêter avant la fin du parcours, nous en discutons directement, aucune pénalité n'est appliquée au delà des séances déjà réalisées ou engagées selon les modalités convenues à la signature.</p>
              </details>
              <details class="faq-item">
                <summary>Que se passe-t-il si j'annule ou déplace une séance ?</summary>
                <p>Toute séance annulée avec un préavis de 48 heures peut être reprogrammée sans frais. En deçà de ce délai, la séance reste due, sauf situation exceptionnelle.</p>
              </details>
            </div>
            <p class="faq-cta"><a href="https://thecoachpilot.com/book/david-delord/echange-decouverte-30-min-m-p-coaching" target="_blank" rel="noopener">Une question reste sans réponse ? Réservez un premier échange de 30 minutes →</a></p>
          </div>

        </div>
      </section>

      <!-- ════════════════════════════════
           CERTIFICATIONS & ÉTHIQUE
           ════════════════════════════════ -->
      <section class="certifications">
        <div class="container">
          <p class="label">Garanties</p>
          <h2>Une pratique encadrée. Pas une promesse.</h2>
          <p class="certif-intro">Le coaching est un secteur non réglementé. La supervision régulière et l'inscription à une charte éthique ne sont pas des ornements. Ce sont les seuls repères objectifs qui permettent de distinguer une pratique sérieuse.</p>

          <div class="certif-grid">

            <div class="certif-card">
              <div class="certif-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>
              <h3>Pratique supervisée</h3>
              <p>Supervision régulière par un coach senior. La supervision n'est pas une obligation légale, c'est une exigence éthique que je m'impose pour garantir la qualité de ma pratique.</p>
            </div>

            <div class="certif-card">
              <div class="certif-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </div>
              <h3>Confidentialité absolue</h3>
              <p>Étanchéité totale entre la séance et l'institution. Ce qui se dit en séance reste en séance, y compris dans le cadre des contrats tripartites avec les organisations.</p>
            </div>

            <div class="certif-card">
              <div class="certif-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </div>
              <h3>Charte Éthique du Coaching</h3>
              <p>Engagement formel sur les principes déontologiques de la profession : respect de l'autonomie du client, absence de manipulation, clarté des rôles et des limites d'intervention.</p>
            </div>

          </div>

          <div class="rc-pro">
            <p>SASU · RC Pro souscrite · Siret disponible sur demande</p>
          </div>
        </div>
      </section>

      <!-- ════════════════════════════════
           CTA FINAL
           ════════════════════════════════ -->
      <section class="about-cta">
        <div class="container">
          <p class="cta-accroche">Envie d'en savoir plus ? 30 minutes suffisent.</p>
          <a href="https://thecoachpilot.com/book/david-delord/echange-decouverte-30-min-m-p-coaching" target="_blank" rel="noopener" class="cta">
            Je réserve
          </a>
          <p class="cta-note">Sans engagement · Visio ou présentiel Occitanie</p>
        </div>
      </section>

    </main>
    <Footer />
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  img { display: block; max-width: 100%; }

  :root {
    --kaki:      #535861;
    --kaki-p:    #535861;
    --or:        #C99763;
    --or-p:      #b07d45;
    --creme:     #F4F1EA;
    --sage:      #7F9B88;
    --vert-the:  #A8B8A2;
    --texte:     #535861;
    --blanc:     #ffffff;
    --rayon:     4px;
  }

  /* ── FAQ ── */
  .faq {
    background: var(--creme);
    padding: 4rem 1.5rem;
  }
  .faq-block {
    margin-bottom: 3.5rem;
  }
  .faq-block:last-child {
    margin-bottom: 0;
  }
  .faq-block-title {
    font-size: 1.4rem;
    color: var(--kaki);
    margin-bottom: 1.25rem;
    line-height: 1.25;
  }
  .faq-block--concret   { --accent: var(--kaki); }
  .faq-block--methode   { --accent: var(--sage); }
  .faq-block--cadre     { --accent: var(--or-p); }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .faq-item {
    background: var(--blanc);
    border-radius: var(--rayon);
    border-left: 4px solid var(--accent);
    overflow: hidden;
  }
  .faq-item summary {
    cursor: pointer;
    list-style: none;
    padding: 1.05rem 2.6rem 1.05rem 1.3rem;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    color: var(--accent);
    font-size: 0.96rem;
    line-height: 1.4;
    position: relative;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: 1.3rem;
    top: 1.0rem;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .faq-item[open] summary::after { content: '\2212'; }
  .faq-item p {
    margin: 0;
    padding: 0 1.3rem 1.15rem;
    color: var(--texte);
    line-height: 1.75;
    font-size: 0.94rem;
  }
  .faq-item strong { color: var(--accent); }

  .methode-etapes {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0 1.3rem;
    margin-bottom: 0.9rem;
  }
  .etape {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--blanc);
  }
  .etape--maitrise    { background: var(--kaki); }
  .etape--mouvement   { background: var(--sage); }
  .etape--progression { background: var(--or-p); }

  .faq-cta {
    margin-top: 1.4rem;
    font-size: 0.92rem;
  }
  .faq-cta a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .faq-cta a:hover { text-decoration: underline; }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--sage);
    font-weight: 600;
    margin-bottom: 0.4rem;
    display: block;
  }
  .label-gold { color: var(--or-p); }
  .br-d { display: none; }

  /* ── HERO ── */
  .about-hero {
    background: var(--anthracite);
    color: var(--creme);
    padding: 4rem 1.5rem 3.5rem;
  }
  .about-hero h1 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--creme);
    margin-bottom: 1.25rem;
  }
  .hero-sous {
    font-size: 1rem;
    color: #C8C4B8;
    line-height: 1.75;
    max-width: 680px;
    font-style: italic;
  }

  /* ── PHILOSOPHIE ── */
  .philosophie {
    background: var(--blanc);
    padding: 4rem 1.5rem;
  }
  .philo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .philo-texte h2 {
    font-size: 1.5rem;
    color: var(--kaki);
    margin-bottom: 1.25rem;
    line-height: 1.25;
  }
  .philo-texte p {
    color: var(--texte);
    line-height: 1.8;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }
  blockquote {
    margin: 0 0 2rem;
    padding: 1.5rem;
    background: var(--anthracite);
    border-radius: var(--rayon);
  }
  blockquote p {
    color: var(--anthracite);
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.65;
    margin: 0;
  }
  .philo-valeurs {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
